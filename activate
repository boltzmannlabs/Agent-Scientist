#!/usr/bin/env bash
# ============================================================================
# venv-style activation for the Sci dev environment (pm-managed tools).
#
#   source ./activate      (bash / zsh, repo root)
#   .\activate.ps1         (PowerShell)
#
# Emits the composed pm env (PATH + tool vars) into the CURRENT shell, with
# save/restore: `deactivate` undoes exactly what activation changed.
#
# `sci` becomes a shell function for this checkout. It runs only while the
# shell is inside this worktree and refuses outside it, so a sibling worktree
# keeps its own command. A prompt prefix names the worktree.
#
# Sync through setup before selecting the environment. PM owns freshness;
# activation does not maintain a second dependency stamp. It trusts the
# recorded tool digest instead of re-hashing every entry. `sci pm
# install` and `sci update` keep that check.
# ============================================================================
_SCI_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Options: `--test-extras a,b` selects the test environment's runtime extras
# (default: [all]); `--` ends options.
# A bare `source ./activate` inherits the caller's positional parameters.
# Ignore unrelated words so scripts with their own arguments can source it.
_sci_test_env="--test-environment"
_sci_expect_extras=""
for _sci_arg in "$@"; do
    if [ -n "$_sci_expect_extras" ]; then
        _sci_test_env="--test-environment=$_sci_arg"
        _sci_expect_extras=""
        continue
    fi
    case "$_sci_arg" in
        --) break ;;
        --test-extras) _sci_expect_extras=1 ;;
        --test-extras=*) _sci_test_env="--test-environment=${_sci_arg#--test-extras=}" ;;
        *) : ;;
    esac
done
if [ -n "$_sci_expect_extras" ]; then
    printf '%s\n' 'activate: --test-extras needs a comma-separated list' >&2
    unset _sci_arg _sci_test_env _sci_expect_extras
    return 2 2>/dev/null || exit 2
fi
# Setup runs in a child: failures must not exit or partially activate the
# caller's shell, and activation must not republish launchers or shell config.
if ! (
    unset PYTHONHOME PYTHONPATH VIRTUAL_ENV
    bash "$_SCI_REPO/setup-sci.sh" --runtime-only "$_sci_test_env"
) >&2; then
    printf '%s\n' 'activate: setup failed; shell environment unchanged' >&2
    unset _sci_arg _sci_test_env _sci_expect_extras
    return 1 2>/dev/null || exit 1
fi
unset _sci_arg _sci_test_env _sci_expect_extras

# Guard against double-sourcing: venv activate precedent (re-activating is a
# no-op re-save; we keep it idempotent by deactivating first). Key on the
# function, not the sentinel: child shells inherit __SCI_ACTIVATED from an
# activated parent but never the function, and there is nothing to undo there.
if [ "$(type -t deactivate 2>/dev/null)" = "function" ]; then
    deactivate
fi

# Bootstrap Python only emits the environment; it does not install anything.
_sci_repo="$_SCI_REPO"
_sci_py=""
for _sci_candidate in "$_sci_repo/.venv/bin/python" "$_sci_repo/.venv/Scripts/python.exe" \
                         "$_sci_repo/venv/bin/python" "$_sci_repo/venv/Scripts/python.exe"; do
    [ -x "$_sci_candidate" ] && { _sci_py="$_sci_candidate"; break; }
done
if [ -z "$_sci_py" ]; then
    for _sci_store in "${SCI_RUNTIME_DIR:-}" "$_sci_repo/../tools" "${SCI_HOME:-$HOME/.sci}/tools"; do
        [ -n "$_sci_store" ] || continue
        for _sci_candidate in "$_sci_store"/python-*/bin/python3 "$_sci_store"/python-*/python.exe "$_sci_store"/python-*/bin/python "$_sci_store"/python-*/bin/python.exe; do
            [ -x "$_sci_candidate" ] && { _sci_py="$_sci_candidate"; break; }
        done
        [ -n "$_sci_py" ] && break
    done
fi
if [ -z "$_sci_py" ]; then
    echo "activate: no bootstrap Python found; run setup-sci.sh" >&2
    return 1 2>/dev/null || exit 1
fi

# --- emit export lines from `pm env` ---
_sci_json="$(PYTHONHOME= PYTHONPATH="$_sci_repo" "$_sci_py" -m pm.environments)"
if [ -z "$_sci_json" ] || [ "${_sci_json#*{}" = "$_sci_json" ]; then
    echo "activate: could not read pm env (run ./setup-sci.sh first)" >&2
    unset _sci_repo _sci_os _sci_arch _sci_target _sci_store _sci_py _sci_json
    return 1 2>/dev/null || exit 1
fi

_sci_keys="$(printf '%s' "$_sci_json" | "$_sci_py" -c 'import json,sys; print(" ".join(json.load(sys.stdin)))' \
    | tr ' ' '\n' | grep -E '^[A-Za-z_][A-Za-z0-9_]*$' | tr '\n' ' ')"
[ -n "$_sci_keys" ] || _sci_keys="PATH"

# --- snapshot what we are about to change (deactivate restores this) ---
# __SCI_ACTIVATED is part of the composed env below (it carries the
# installed-state path this environment was built from), so it is snapshotted
# and exported with every other key — no separate assignment here.
__SCI_SAVED_PATH="$PATH"
for _sci_k in $_sci_keys; do
    eval "__SCI_SAVED_$_sci_k=\"\${$_sci_k+set}\""
    eval "__SCI_PRIOR_$_sci_k=\${$_sci_k-__SCI_UNSET__}"
done

# Resolved before the export below replaces PATH.
_sci_cygpath="$(command -v cygpath 2>/dev/null || :)"

eval "$(printf '%s' "$_sci_json" | "$_sci_py" -c '
import json, sys, shlex, re
for k, v in json.load(sys.stdin).items():
    # Windows carries names like ProgramFiles(ARM) that are not valid
    # bash identifiers — skip them (they pass through untouched).
    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", k):
        continue
    print("export %s=%s" % (k, shlex.quote(str(v))))')"

# The MSYS/Cygwin runtime hands a native Windows Python these variables in
# Windows form (`C:\a;C:\b`) and converts them back only for its own children.
# Exported verbatim, bash splits PATH on ':' and finds no commands.
if [ -n "$_sci_cygpath" ]; then
    PATH="$("$_sci_cygpath" -u -p "$PATH")"
    for _sci_k in HOME TMPDIR TMP TEMP; do
        if [ -n "${!_sci_k-}" ]; then
            printf -v "$_sci_k" '%s' "$("$_sci_cygpath" -u "${!_sci_k}")"
        fi
    done
fi

# This checkout, not whichever `sci` PATH finds. A function beats PATH, an
# alias, and a hashed command, including the MSIX execution alias.
__SCI_WORKTREE="$_sci_repo"
# The branch names the worktree. A checkout cannot share a branch with another.
__SCI_WORKTREE_NAME="$(git -C "$_sci_repo" rev-parse --abbrev-ref HEAD 2>/dev/null || :)"
if [ -z "$__SCI_WORKTREE_NAME" ] || [ "$__SCI_WORKTREE_NAME" = HEAD ]; then
    __SCI_WORKTREE_NAME="$(basename "$_sci_repo")"
fi
__SCI_SAVED_PS1="${PS1-__SCI_UNSET__}"
__SCI_SAVED_PROMPT_COMMAND="${PROMPT_COMMAND-__SCI_UNSET__}"

_sci_worktree_here() {
    _sci_top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
    [ "$(cd "$_sci_top" && pwd -P)" = "$(cd "$__SCI_WORKTREE" && pwd -P)" ]
}

sci() {
    _sci_worktree_here || {
        printf '%s\n' "sci: $(pwd) is outside $__SCI_WORKTREE; refusing (the installed command is hidden while this checkout is active)" >&2
        return 1
    }
    (
        cd "$__SCI_WORKTREE" || exit 1
        if [ -n "${PYTHON-}" ]; then
            exec "$PYTHON" sci "$@"
        elif [ -x .venv/Scripts/python.exe ]; then
            exec .venv/Scripts/python.exe sci "$@"
        elif [ -x .venv/bin/python ]; then
            exec .venv/bin/python sci "$@"
        elif [ -x venv/Scripts/python.exe ]; then
            exec venv/Scripts/python.exe sci "$@"
        elif [ -x venv/bin/python ]; then
            exec venv/bin/python sci "$@"
        else
            exec python sci "$@"
        fi
    )
}

_sci_prompt() {
    if [ "$__SCI_SAVED_PS1" = "__SCI_UNSET__" ]; then
        _sci_base_ps1=""
    else
        _sci_base_ps1="$__SCI_SAVED_PS1"
    fi
    if _sci_worktree_here; then
        PS1="($__SCI_WORKTREE_NAME) $_sci_base_ps1"
    else
        PS1="$_sci_base_ps1"
    fi
}

if [ -n "${PROMPT_COMMAND-}" ]; then
    PROMPT_COMMAND="_sci_prompt; ${PROMPT_COMMAND}"
else
    PROMPT_COMMAND=_sci_prompt
fi
_sci_prompt

deactivate() {
    export PATH="$__SCI_SAVED_PATH"
    for _sci_k in $__SCI_KEY_LIST; do
        eval "_sci_was=\"\$__SCI_SAVED_$_sci_k\""
        eval "_sci_old=\"\$__SCI_PRIOR_$_sci_k\""
        if [ "$_sci_was" != "set" ]; then
            unset "$_sci_k"
        else
            export "$_sci_k=$_sci_old"
        fi
        unset "__SCI_SAVED_$_sci_k" "__SCI_PRIOR_$_sci_k"
    done
    if [ "$__SCI_SAVED_PS1" = "__SCI_UNSET__" ]; then
        unset PS1
    else
        PS1="$__SCI_SAVED_PS1"
    fi
    if [ "$__SCI_SAVED_PROMPT_COMMAND" = "__SCI_UNSET__" ]; then
        unset PROMPT_COMMAND
    else
        PROMPT_COMMAND="$__SCI_SAVED_PROMPT_COMMAND"
    fi
    unset __SCI_SAVED_PATH __SCI_KEY_LIST __SCI_ACTIVATED \
          __SCI_WORKTREE __SCI_WORKTREE_NAME \
          __SCI_SAVED_PS1 __SCI_SAVED_PROMPT_COMMAND
    unset -f deactivate sci _sci_worktree_here _sci_prompt
    unset _sci_k _sci_was _sci_old _sci_top
}

# remember the key list for deactivate (kept out of the loop vars above)
__SCI_KEY_LIST="$_sci_keys"

unset _sci_repo _sci_os _sci_arch _sci_target _sci_store \
      _sci_py _sci_json _sci_keys _sci_k _sci_entry _sci_venvpy \
      _sci_winarch _sci_top _sci_cygpath
