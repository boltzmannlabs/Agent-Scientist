{
  "name": "@sci/ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "SCI's bundled React components and styles",
  "sideEffects": ["**/*.css"],
  "exports": {
    "./ui/*": { "types": "./lib/ui/*.d.ts", "import": "./lib/ui/*.js" },
    "./utils": { "types": "./lib/utils/index.d.ts", "import": "./lib/utils/index.js" },
    "./utils/*": { "types": "./lib/utils/*.d.ts", "import": "./lib/utils/*.js" },
    "./hooks/*": { "types": "./lib/hooks/*.d.ts", "import": "./lib/hooks/*.js" },
    "./fonts/*": "./lib/fonts/*",
    "./styles/fonts.css": "./lib/ui/fonts.css",
    "./styles/globals.css": "./lib/ui/globals.css"
  },
  "dependencies": {
    "@nanostores/react": "1.1.0",
    "radix-ui": "1.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "nanostores": "1.3.0",
    "sanitize-html": "2.18.0",
    "gsap": "3.15.0",
    "leva": "0.10.1",
    "three": "0.180.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "unicode-animations": "1.0.3"
  },
  "peerDependencies": { "react": "^19.0.0", "react-dom": "^19.0.0" }
}
