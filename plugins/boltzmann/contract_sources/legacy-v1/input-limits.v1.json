          "type": "list"
        },
        "custom_models": {
          "type": "list"
        }
      },
      "any_of_nonempty": [
        [
          "global_models",
          "custom_models"
        ]
      ],
      "combined_items": [
        {
          "fields": [
            "global_models",
            "custom_models"
