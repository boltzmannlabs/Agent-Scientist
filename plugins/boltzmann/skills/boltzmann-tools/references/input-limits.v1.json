{
  "schema": "boltzmann-input-limits.v1",
  "policy": "Only source-backed hard limits are encoded. Defaults and recommendations are not hard limits.",
  "tools": {
    "Random_Antibody_Generation": {
      "fields": {
        "n_samples": {
          "exclusive_minimum": 16,
          "recommended_minimum": 20
        }
      }
    },
    "AntiBMPNN": {
      "fields": {
        "generation_count": {
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "pxdesigninfer": {
      "fields": {
        "binder_length": {
          "minimum": 10,
          "maximum": 300
        },
        "n_samples": {
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "Genzyme_Generation": {
      "fields": {
        "num_structures": {
          "minimum": 1,
          "maximum": 100000
        }
      }
    },
    "Placer": {
      "fields": {
        "no_of_samples": {
          "minimum": 10,
          "maximum": 100
        }
      }
    },
    "Sequence_based_peptide_generation": {
      "fields": {
        "seq_length": {
          "minimum": 11,
          "maximum": 50
        }
      }
    },
    "Structure_Based_Generator": {
      "fields": {
        "no_of_shapes": {
          "minimum": 1
        },
        "no_of_decodings": {
          "minimum": 1
        }
      }
    },
    "siRNA_obj_pred": {
      "fields": {
        "min_gc": {
          "minimum": 0,
          "maximum": 100
        },
        "max_gc": {
          "minimum": 0,
          "maximum": 100
        }
      },
      "relations": [
        {
          "left": "min_gc",
          "operator": "<=",
          "right": "max_gc"
        }
      ]
    },
    "CodonRLBERTPropPred": {
      "fields": {
        "selected_properties": {
          "min_items": 1
        }
      }
    },
    "Random_based_generation_training": {
      "fields": {
        "num_samples": {
          "maximum": 5000
        }
      },
      "any_of_nonempty": [
        [
          "global_models",
          "custom_models"
        ]
      ]
    },
    "Random_based_generation_nontrans": {
      "fields": {
        "num_samples": {
          "exclusive_minimum": 0
        }
      },
      "any_of_nonempty": [
        [
          "global_models",
          "custom_models"
        ]
      ],
      "combined_items": [
        {
          "fields": [
            "global_models",
            "custom_models"
          ],
          "maximum": 3
        }
      ]
    },
    "peptiverse": {
      "fields": {
        "properties": {
          "min_items": 1
        }
      }
    },
    "ipsae-protein": {
      "fields": {
        "pae_cutoff": {
          "exclusive_minimum": 0
        },
        "dist_cutoff": {
          "exclusive_minimum": 0
        }
      }
    },
    "Property_Prediction": {
      "any_of_nonempty": [
        [
          "global_models",
          "custom_models"
        ]
      ]
    }
  }
}
